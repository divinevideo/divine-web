# Sentry Error Tracking
# Get your DSN from https://sentry.io -> Project Settings -> Client Keys (DSN)
VITE_SENTRY_DSN=https://your-public-key@o123456.ingest.sentry.io/project-id

# Optional: Enable Sentry in development (default: disabled)
# VITE_SENTRY_DEV_ENABLED=true

# Product analytics is off unless explicitly enabled for a build.
VITE_PRODUCT_ANALYTICS_ENABLED=false

# Chat POC routes (/chat, /invite/<naddr>) are on in dev and off in production
# builds unless this is set; PR previews set it.
# VITE_CHAT_POC_ENABLED=true

# Chat POC relay (staging default in code; production would be wss://relay.divine.video)
# VITE_CONCORD_RELAY_URL=wss://relay.staging.dvines.org
# VITE_CHAT_RELAY_URL=wss://relay.staging.dvines.org (legacy alias)
# Short links are enabled without login. Set false to use full URLs.
VITE_SHORT_LINKS_ENABLED=true
