# Sentry Error Tracking
# Get your DSN from https://sentry.io -> Project Settings -> Client Keys (DSN)
VITE_SENTRY_DSN=https://your-public-key@o123456.ingest.sentry.io/project-id

# Optional: Enable Sentry in development (default: disabled)
# VITE_SENTRY_DEV_ENABLED=true

# Product analytics is off unless explicitly enabled for a build.
VITE_PRODUCT_ANALYTICS_ENABLED=false

# Short links are enabled for signed-in users. Set false to use full URLs.
VITE_SHORT_LINKS_ENABLED=true
